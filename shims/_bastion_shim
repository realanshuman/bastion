#!/usr/bin/env bash
# Bastion execution guard. Installed as node/npm/npx/pnpm/yarn/bun in ~/.security-guard/shims.
# Default behavior: transparently exec the REAL tool. Only BLOCKS on a payload signature.
selfdir="$HOME/.security-guard/shims"
name="$(basename "$0")"
log(){ echo "$(date '+%F %T')  BLOCKED [$name]: $1" >> "$HOME/.security-guard/ALERTS.txt" 2>/dev/null; osascript -e "display notification \"Blocked $name: $1\" with title \"🛡 Bastion — prevented execution\" sound name \"Basso\"" >/dev/null 2>&1 || true; }
# resolve the REAL binary = next one in PATH that isn't this shim dir
real=""; IFS=: read -ra parts <<< "$PATH"
for d in "${parts[@]}"; do [ "$d" = "$selfdir" ] && continue; [ -x "$d/$name" ] && { real="$d/$name"; break; }; done
[ -z "$real" ] && { echo "bastion-shim: real $name not found in PATH" >&2; exit 127; }

PAYLOAD_RE="global\.[a-z]{1,2}[[:space:]]*=[[:space:]]*['\"][0-9]+-|_\\\$_[0-9a-f]{4}[[:space:]]*=[[:space:]]*\(function|createRequire\(import\.meta\.url\)[^\n]{0,40}global\["
scan_configs(){ # $1 = dir; block if a config file carries the injection shape
  local hit=""
  while IFS= read -r f; do
    local L; L=$(awk '{if(length($0)>m)m=length($0)}END{print m+0}' "$f" 2>/dev/null)
    if [ "${L:-0}" -gt 500 ] || grep -qE "global\.[a-z]{1,2}[[:space:]]*=[[:space:]]*['\"][0-9]+-|_\\\$_[0-9a-f]{4}[[:space:]]*=[[:space:]]*\(function" "$f" 2>/dev/null; then hit="$f"; break; fi
  done < <(find "$1" -maxdepth 2 -name '*.config.*' -not -path '*/node_modules/*' 2>/dev/null)
  [ -n "$hit" ] && { echo "$hit"; return 0; }; return 1
}

case "$name" in
  node)
    # block the loader: `node -e '<payload>'`
    prev=""
    for a in "$@"; do
      if [ "$prev" = "-e" ] || [ "$prev" = "--eval" ]; then
        if printf '%s' "$a" | grep -qE "$PAYLOAD_RE" || [ "${#a}" -gt 2000 ]; then
          log "node -e loader payload"; echo "🛡 Bastion blocked a node -e infostealer loader. Not executed." >&2; exit 1
        fi
      fi; prev="$a"
    done ;;
  npm|pnpm|yarn|bun|npx)
    # before dev/build/start/test/gen scripts, refuse if the repo config is injected
    case " $* " in
      *" dev "*|*" build "*|*" start "*|*" test "*|*" gen:api "*|*" run "*|*" preview "*)
        bad=$(scan_configs "$PWD") && { log "injected config in $bad"; echo "🛡 Bastion blocked '$name $*' — injected config: $bad" >&2; echo "   Clean the file before running (git checkout from a trusted branch, or fix by hand)." >&2; exit 1; }
;;
    esac ;;
esac
exec "$real" "$@"
